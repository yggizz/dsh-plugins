  "plugins": [
    {
      "name": "dsh-plugin-suite",
      "title": {
        "en": "Plugin suite",
        "zh": "小插件套件"
      },
      "description": {
        "en": "Eight small local features in one bundle: file right-click copy, light/dark toggle, refresh/restart, per-turn spend, hidden branch button, remembered unpinned panels, right sidebar open by default, one-click archive filter. Each has its own switch under Settings → Plugin suite, applied immediately. The configuration lives in ~/.dsh/plugin-suite.json.",
        "zh": "把八个自研小功能装进一个插件包：文件右键复制、深浅色切换、刷新/重启、每轮花费、隐藏分支按钮、记住取消固定的面板、右侧栏默认展开、归档筛选一键切换。设置 → 小插件 里可以逐个开关，改动即时生效。配置保存在 ~/.dsh/plugin-suite.json。"
      },
      "icon": "https://raw.githubusercontent.com/yggizz/dsh-plugins/4e04fdc02507175973b09ffbb804c14ca927d44b/packages/dsh-plugin-suite/icon.svg",
