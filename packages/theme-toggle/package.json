{
  "name": "@yggizz/dsh-theme-toggle",
  "version": "1.0.0",
  "type": "module",
  "description": "One-click light and dark theme toggle in the window title bar.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggizz/dsh-plugins.git",
    "directory": "packages/theme-toggle"
  },
  "homepage": "https://github.com/yggizz/dsh-plugins/tree/main/packages/theme-toggle#readme",
  "bugs": {
    "url": "https://github.com/yggizz/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "theme",
    "dark-mode"
  ]
}
