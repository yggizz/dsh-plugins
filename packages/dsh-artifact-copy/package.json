{
  "name": "@yggizz/dsh-artifact-copy",
  "version": "1.0.0",
  "type": "module",
  "description": "Right-click a file in a conversation to copy its relative path, its text contents, or the file itself to the system clipboard.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggizz/dsh-plugins.git",
    "directory": "packages/dsh-artifact-copy"
  },
  "homepage": "https://github.com/yggizz/dsh-plugins/tree/main/packages/dsh-artifact-copy#readme",
  "bugs": { "url": "https://github.com/yggizz/dsh-plugins/issues" },
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "cordis", "clipboard", "context-menu", "file"]
}
