{
  "name": "@yggizz/dsh-sidebar-pins",
  "version": "1.0.0",
  "type": "module",
  "description": "Remembers which left-sidebar panel launchers you unpinned and re-applies that choice on every start.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggizz/dsh-plugins.git",
    "directory": "packages/sidebar-pins"
  },
  "homepage": "https://github.com/yggizz/dsh-plugins/tree/main/packages/sidebar-pins#readme",
  "bugs": { "url": "https://github.com/yggizz/dsh-plugins/issues" },
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "cordis", "sidebar", "layout"]
}
