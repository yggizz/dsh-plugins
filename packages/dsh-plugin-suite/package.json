{
  "name": "dsh-plugin-suite",
  "version": "1.0.1",
  "type": "module",
  "description": "Six small DeepSeek Harness plugins in one bundle — file right-click copy, theme toggle, per-turn spend, hidden branch button, remembered sidebar pins, right sidebar open by default — each with its own switch on a Settings page.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "features",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggizz/dsh-plugins.git",
    "directory": "packages/dsh-plugin-suite"
  },
  "homepage": "https://github.com/yggizz/dsh-plugins/tree/main/packages/dsh-plugin-suite#readme",
  "bugs": {
    "url": "https://github.com/yggizz/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "plugin-suite",
    "theme",
    "sidebar"
  ]
}
